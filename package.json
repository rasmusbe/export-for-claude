{
  "name": "export-for-claude",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chromium MV3 extension that exports the open claude.ai conversation to Markdown, JSON and PDF, and downloads its files as a zip.",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "marked": "^18.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.8",
    "@types/node": "^26.6.11",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "license": "MIT"
}
