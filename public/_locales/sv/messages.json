  "popupZipCount": {
    "message": "Ladda ner filer ($count$)",
    "placeholders": {
      "count": {
        "content": "$1",
        "example": "3"
      }
    }
  },
  "statusFetching": {
    "message": "Hämtar konversationen…"
  },
  "statusSaving": {
    "message": "Sparar…"
  },
  "statusDone": {
    "message": "Klart: $filename$",
    "placeholders": {
      "filename": {
        "content": "$1",
        "example": "2026-03-05 Titel.md"
      }
    }
  },
  "statusDonePartial": {
    "message": "Klart: $filename$. $failed$ av $total$ filer kunde inte hämtas (se $missing$).",
    "placeholders": {
      "filename": {
        "content": "$1",
        "example": "2026-03-05 Titel – filer.zip"
      },
      "failed": {
        "content": "$2",
        "example": "1"
      },
      "total": {
        "content": "$3",
        "example": "4"
      },
      "missing": {
        "content": "$4",
        "example": "saknas.txt"
      }
    }
  },
  "statusSaveFailed": {
    "message": "Kunde inte spara filen: $reason$",
    "placeholders": {
      "reason": {
        "content": "$1",
        "example": "Ingen kontakt"
      }
    }
  },
  "statusFetchingFiles": {
    "message": "Hämtar filer… $done$ av $total$",
    "placeholders": {
      "done": {
        "content": "$1",
        "example": "2"
      },
      "total": {
        "content": "$2",
        "example": "5"
      }
    }
  },
